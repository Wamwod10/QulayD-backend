# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
API_PREFIX=/api/v1
APP_VERSION=1.0.0
LOG_LEVEL=info
TRUST_PROXY=false
BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=10000

# PostgreSQL / Neon
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qulay?schema=public
DATABASE_HEALTH_TIMEOUT_MS=3000

# Browser clients. Separate multiple origins with commas.
CORS_ORIGIN=https://qulay-d.vercel.app,http://localhost:5173
CORS_CREDENTIALS=true

# API protection
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
SWAGGER_ENABLED=true

# Authentication. Generate independent secrets with at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=qulay-api
JWT_AUDIENCE=qulay-web
BCRYPT_ROUNDS=12
PASSWORD_RESET_TTL_MINUTES=30
# Optional HTTPS endpoint for email/SMS provider integration.
PASSWORD_RESET_WEBHOOK_URL=
FRONTEND_RESET_URL=https://qulay-d.vercel.app/reset-password
AUTH_RATE_LIMIT_MAX=20

# Image uploads. Use Render persistent disk or an external object-storage adapter.
UPLOAD_MAX_FILE_SIZE_MB=8
UPLOAD_DIR=uploads
UPLOAD_STORAGE_PROVIDER=
UPLOAD_BUCKET=
UPLOAD_PUBLIC_BASE_URL=
VITE_YANDEX_MAPS_API_KEY=b0e98344-66ac-4b61-bb53-9cfa179aa9e5
