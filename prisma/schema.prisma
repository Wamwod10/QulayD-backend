  @@index([companyId, customerId, occurredAt])
  @@index([companyId, supplierId, occurredAt])
}

model Return {
  id         String       @id @default(uuid()) @db.Uuid
  companyId  String       @db.Uuid
  orderId    String?      @db.Uuid
  customerId String?      @db.Uuid
  number     String
  status     ReturnStatus @default(DRAFT)
  reason     String?
  total      Decimal      @default(0) @db.Decimal(18, 2)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  order      Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items      ReturnItem[]

  @@unique([companyId, number])
  @@index([companyId, status, createdAt])
}

model ReturnItem {
  id               String          @id @default(uuid()) @db.Uuid
  returnId         String          @db.Uuid
  orderItemId      String?         @db.Uuid
  productId        String          @db.Uuid
  variantId        String?         @db.Uuid
  packageId        String?         @db.Uuid
  quantity         Decimal         @db.Decimal(18, 3)
  baseQuantity     Decimal?        @db.Decimal(18, 3)
  conversionToBase Decimal         @default(1) @db.Decimal(18, 6)
  unitPrice        Decimal         @db.Decimal(18, 2)
  total            Decimal         @db.Decimal(18, 2)
  condition        String?
  serialIds        Json            @default("[]")
  batchAllocations Json            @default("[]")
  return           Return          @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem        OrderItem?      @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  product          Product         @relation(fields: [productId], references: [id])
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  package          ProductPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([returnId])
}

model Territory {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      String          @db.Uuid
  name           String
  code           String
  geometry       Json            @default("{}")
  status         RecordStatus    @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  routeTemplates RouteTemplate[]

  @@unique([companyId, code])
}

model RouteTemplate {
  id          String              @id @default(uuid()) @db.Uuid
  companyId   String              @db.Uuid
  territoryId String?             @db.Uuid
  agentId     String?             @db.Uuid
  name        String
  dayOfWeek   Int?
  status      RecordStatus        @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  territory   Territory?          @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  agent       Employee?           @relation("TemplateAgent", fields: [agentId], references: [id], onDelete: SetNull)
  stops       RouteTemplateStop[]
  plans       RoutePlan[]

  @@index([companyId, status])
}

model RouteTemplateStop {
  id         String        @id @default(uuid()) @db.Uuid
  templateId String        @db.Uuid
  customerId String        @db.Uuid
  stopOrder  Int
  template   RouteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([templateId, customerId])
  @@unique([templateId, stopOrder])
}

model RoutePlan {
  id         String          @id @default(uuid()) @db.Uuid
  companyId  String          @db.Uuid
  templateId String?         @db.Uuid
  agentId    String?         @db.Uuid
  name       String
  planDate   DateTime
  status     DocumentStatus  @default(DRAFT)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  template   RouteTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  agent      Employee?       @relation("PlanAgent", fields: [agentId], references: [id], onDelete: SetNull)
  stops      RoutePlanStop[]

  @@index([companyId, planDate, status])
}

model RoutePlanStop {
  id          String      @id @default(uuid()) @db.Uuid
  routePlanId String      @db.Uuid
  customerId  String      @db.Uuid
  stopOrder   Int
  status      VisitStatus @default(PLANNED)
  visitedAt   DateTime?
  routePlan   RoutePlan   @relation(fields: [routePlanId], references: [id], onDelete: Cascade)
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([routePlanId, customerId])
  @@unique([routePlanId, stopOrder])
}

model Visit {
  id         String      @id @default(uuid()) @db.Uuid
  companyId  String      @db.Uuid
  employeeId String      @db.Uuid
  customerId String      @db.Uuid
  status     VisitStatus @default(PLANNED)
