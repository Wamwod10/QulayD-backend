model Notification {
  id         String             @id @default(uuid()) @db.Uuid
  companyId  String             @db.Uuid
  employeeId String?            @db.Uuid
  type       NotificationType   @default(INFO)
  status     NotificationStatus @default(UNREAD)
  title      String
  message    String
  module     String?
  actionUrl  String?
