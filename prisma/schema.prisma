model PaymentMethodConfig {
  id             String        @id @default(uuid()) @db.Uuid
  companyId      String        @db.Uuid
  code           String
  name           String
  method         PaymentMethod
  shortcut       String?
  commissionRate Decimal       @default(0) @db.Decimal(8, 4)
  metadata       Json          @default("{}")
  status         RecordStatus  @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
}

model HeldCart {
  id         String         @id @default(uuid()) @db.Uuid
  companyId  String         @db.Uuid
  employeeId String         @db.Uuid
  customerId String?        @db.Uuid
  name       String?
  note       String?
  expiresAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  customer   Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items      HeldCartItem[]

  @@index([companyId, employeeId, createdAt])
}

model HeldCartItem {
  id         String   @id @default(uuid()) @db.Uuid
  heldCartId String   @db.Uuid
  productId  String   @db.Uuid
  quantity   Decimal  @db.Decimal(18, 3)
  unitPrice  Decimal  @db.Decimal(18, 2)
  discount   Decimal  @default(0) @db.Decimal(18, 2)
  heldCart   HeldCart @relation(fields: [heldCartId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([heldCartId, productId])
}

model Approval {
  id            String         @id @default(uuid()) @db.Uuid
  companyId     String         @db.Uuid
  requestedById String         @db.Uuid
  reviewedById  String?        @db.Uuid
  entity        String
  entityId      String
  action        String
  status        DocumentStatus @default(PENDING_APPROVAL)
  reason        String?
  payload       Json           @default("{}")
  reviewedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestedBy   Employee       @relation("ApprovalRequester", fields: [requestedById], references: [id])
  reviewedBy    Employee?      @relation("ApprovalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([companyId, status, createdAt])
  @@index([companyId, entity, entityId])
}

model CurrencyRate {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  base        String
  quote       String
  rate        Decimal  @db.Decimal(18, 6)
  source      String?
  effectiveAt DateTime
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, base, quote, effectiveAt])
  @@index([companyId, effectiveAt])
}
