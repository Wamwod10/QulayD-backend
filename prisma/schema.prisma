generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CompanyStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CLOSED
}

enum EmployeeStatus {
  INVITED
  ACTIVE
  BLOCKED
  TERMINATED
}

enum OrderStatus {
  DRAFT
  PENDING_APPROVAL
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum FulfillmentStatus {
  UNFULFILLED
  RESERVED
  PICKING
  PICKED
  PACKING
  PACKED
  FULFILLED
  CANCELLED
}

enum DeliveryStatus {
  NOT_PLANNED
  PLANNED
  OUT_FOR_DELIVERY
  ARRIVED
  DELIVERED
  PARTIALLY_DELIVERED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  QR
  BANK
  CREDIT
  MIXED
  OTHER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum StockMovementType {
  OPENING
  GOODS_RECEIPT
  SALE
  RETURN_IN
  RETURN_OUT
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  COUNT_CORRECTION
  RESERVATION
  RESERVATION_RELEASE
}

enum DocumentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  CANCELLED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum CashTransactionType {
  OPENING
  SALE
  REFUND
  INCOME
  EXPENSE
  CASH_IN
  CASH_OUT
  CLOSING
}

enum LedgerSide {
  DEBIT
  CREDIT
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  ACTION_REQUIRED
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum UploadStatus {
  PENDING
  READY
  FAILED
  DELETED
}

enum VisitStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  MISSED
  CANCELLED
}

enum ReturnStatus {
  DRAFT
  REQUESTED
  INSPECTING
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
  CANCELLED
}

enum ProductSerialStatus {
  AVAILABLE
  RESERVED
  SOLD
  RETURNED
  DAMAGED
}

model Company {
  id                String                @id @default(uuid()) @db.Uuid
  name              String
  legalName         String?
  taxId             String?
  phone             String?
  email             String?
  address           String?
  plan              String                @default("TRIAL")
  status            CompanyStatus         @default(TRIAL)
  trialEndsAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?
  branches          Branch[]
  warehouses        Warehouse[]
  employees         Employee[]
  roles             Role[]
  categories        Category[]
  units             Unit[]
  products          Product[]
  priceLists        PriceList[]
  customers         Customer[]
  suppliers         Supplier[]
  orders            Order[]
  payments          Payment[]
  invoices          Invoice[]
  cashboxes         Cashbox[]
  settings          Settings?
  sessions          Session[]
  uploads           Upload[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  documentSequences DocumentSequence[]
  employeeTypes     EmployeeType[]
  paymentMethods    PaymentMethodConfig[]
  heldCarts         HeldCart[]
  approvals         Approval[]
  currencyRates     CurrencyRate[]
  productImages     ProductImage[]
  productPackages   ProductPackage[]
  productBatches    ProductBatch[]
  productSerials    ProductSerial[]

  @@index([status])
}

model Branch {
  id         String       @id @default(uuid()) @db.Uuid
  companyId  String       @db.Uuid
  name       String
  code       String
  address    String?
  phone      String?
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouses Warehouse[]
  employees  Employee[]
  orders     Order[]
  cashboxes  Cashbox[]

  @@unique([companyId, code])
  @@index([companyId, status])
}

model Warehouse {
  id               String             @id @default(uuid()) @db.Uuid
  companyId        String             @db.Uuid
  branchId         String?            @db.Uuid
  name             String
  code             String
  address          String?
  latitude         Decimal?           @db.Decimal(10, 7)
  longitude        Decimal?           @db.Decimal(10, 7)
  status           RecordStatus       @default(ACTIVE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch           Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employees        Employee[]
  stocks           WarehouseStock[]
  movements        StockMovement[]
  productBatches   ProductBatch[]
  productSerials   ProductSerial[]
  reservations     StockReservation[]
  sourceTransfers  StockTransfer[]    @relation("TransferSource")
  targetTransfers  StockTransfer[]    @relation("TransferTarget")
  inventoryCounts  InventoryCount[]
  stockAdjustments StockAdjustment[]
  orders           Order[]
  goodsReceipts    GoodsReceipt[]
  cashboxes        Cashbox[]
  deliveryTrips    DeliveryTrip[]

  @@unique([companyId, code])
  @@index([companyId, branchId, status])
}

model Employee {
  id                 String               @id @default(uuid()) @db.Uuid
  companyId          String               @db.Uuid
  branchId           String?              @db.Uuid
  warehouseId        String?              @db.Uuid
  employeeTypeId     String?              @db.Uuid
  login              String?              @unique
  phone              String?              @unique
  email              String?              @unique
  name               String
  title              String?
  passwordHash       String
  pinHash            String?
  mustChangePassword Boolean              @default(false)
  status             EmployeeStatus       @default(INVITED)
  lastLoginAt        DateTime?
  tokenVersion       Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch             Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  warehouse          Warehouse?           @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  employeeType       EmployeeType?        @relation(fields: [employeeTypeId], references: [id], onDelete: SetNull)
  roles              EmployeeRole[]
  modules            EmployeeModule[]
  sessions           Session[]
  passwordResets     PasswordResetToken[]
  createdOrders      Order[]              @relation("OrderCreator")
  assignedOrders     Order[]              @relation("OrderAgent")
  stockMovements     StockMovement[]
  notifications      Notification[]
  notificationReads  NotificationRead[]
  auditLogs          AuditLog[]
  shifts             Shift[]
  payments           Payment[]
  visits             Visit[]
  salaryKpis         EmployeeKpi[]
  salaryPayments     SalaryPayment[]
  deliveryTrips      DeliveryTrip[]       @relation("TripDriver")
  routeTemplates     RouteTemplate[]      @relation("TemplateAgent")
  routePlans         RoutePlan[]          @relation("PlanAgent")
  heldCarts          HeldCart[]
  approvalsRequested Approval[]           @relation("ApprovalRequester")
  approvalsReviewed  Approval[]           @relation("ApprovalReviewer")
  assignedPickLists  PickList[]

  @@index([companyId, status])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  companyId   String?          @db.Uuid
  code        String
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees   EmployeeRole[]
  permissions RolePermission[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  module      String
  action      String
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@index([module])
}

model EmployeeRole {
  employeeId String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([employeeId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model EmployeeModule {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @db.Uuid
  module     String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, module])
  @@index([employeeId, enabled])
}

model Category {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  parentId    String?      @db.Uuid
  name        String
  code        String?
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent      Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]   @relation("CategoryTree")
  products    Product[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId, status])
}

model Unit {
  id        String       @id @default(uuid()) @db.Uuid
  companyId String       @db.Uuid
  name      String
  shortName String
  precision Int          @default(0)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([companyId, name])
  @@unique([companyId, shortName])
}

model Product {
  id                String                @id @default(uuid()) @db.Uuid
  companyId         String                @db.Uuid
  categoryId        String?               @db.Uuid
  unitId            String                @db.Uuid
  supplierId        String?               @db.Uuid
  primaryPriceListId String?              @db.Uuid
  sku               String
  name              String
  description       String?
  manufacturer      String?
  model             String?
  note              String?
  warehouseLocation String?
  imageUrl          String?
  costPrice         Decimal               @default(0) @db.Decimal(18, 2)
  minStock          Decimal               @default(0) @db.Decimal(18, 3)
  trackStock        Boolean               @default(true)
  trackExpiry       Boolean               @default(false)
  trackLot          Boolean               @default(false)
  trackSerial       Boolean               @default(false)
  isMarked          Boolean               @default(false)
  status            RecordStatus          @default(ACTIVE)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?
  company           Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category          Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit              Unit                  @relation(fields: [unitId], references: [id])
  supplier          Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  primaryPriceList  PriceList?            @relation("ProductPrimaryPriceList", fields: [primaryPriceListId], references: [id], onDelete: SetNull)
  images            ProductImage[]
  barcodes          ProductBarcode[]
  variants          ProductVariant[]
  packages          ProductPackage[]
  batches           ProductBatch[]
  serials           ProductSerial[]
  prices            ProductPrice[]
  stocks            WarehouseStock[]
  movements         StockMovement[]
  reservations      StockReservation[]
  orderItems        OrderItem[]
  receiptItems      GoodsReceiptItem[]
  transferItems     StockTransferItem[]
  countItems        InventoryCountItem[]
  adjustmentItems   StockAdjustmentItem[]
  returnItems       ReturnItem[]
  heldCartItems     HeldCartItem[]

  @@unique([companyId, sku])
  @@index([companyId, name])
  @@index([companyId, categoryId, status])
  @@index([companyId, primaryPriceListId])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  productId String   @db.Uuid
  url       String
  alt       String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductBarcode {
  id        String          @id @default(uuid()) @db.Uuid
  companyId String          @db.Uuid
  productId String          @db.Uuid
  variantId String?         @db.Uuid
  packageId String?         @db.Uuid
  barcode   String
  isPrimary Boolean         @default(false)
  createdAt DateTime        @default(now())
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  package   ProductPackage? @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([companyId, barcode])
  @@index([productId])
  @@index([variantId])
  @@index([packageId])
}

model ProductVariant {
  id            String             @id @default(uuid()) @db.Uuid
  companyId     String             @db.Uuid
  productId     String             @db.Uuid
  name          String
  sku           String
  attributes    Json               @default("{}")
  imageUrl      String?
  costPrice     Decimal?           @db.Decimal(18, 2)
  price         Decimal?           @db.Decimal(18, 2)
  status        RecordStatus       @default(ACTIVE)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  barcodes      ProductBarcode[]
  packages      ProductPackage[]
  prices        ProductPrice[]
  batches       ProductBatch[]
  serials       ProductSerial[]
  orderItems    OrderItem[]
  receiptItems    GoodsReceiptItem[]
  returnItems     ReturnItem[]
  heldCartItems   HeldCartItem[]
  transferItems   StockTransferItem[]
  adjustmentItems StockAdjustmentItem[]
  countItems      InventoryCountItem[]
  stocks          WarehouseStock[]

  @@unique([companyId, sku])
  @@index([productId, status])
}

model ProductPackage {
  id                 String             @id @default(uuid()) @db.Uuid
  companyId          String             @db.Uuid
  productId          String             @db.Uuid
  variantId          String?            @db.Uuid
  parentPackageId    String?            @db.Uuid
  name               String
  conversionQuantity Decimal            @db.Decimal(18, 3)
  conversionToBase   Decimal            @db.Decimal(18, 6)
  costPrice          Decimal?           @db.Decimal(18, 2)
  price              Decimal?           @db.Decimal(18, 2)
  status             RecordStatus       @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product            Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant            ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  parent             ProductPackage?    @relation("PackageTree", fields: [parentPackageId], references: [id], onDelete: Restrict)
  children           ProductPackage[]   @relation("PackageTree")
  barcodes           ProductBarcode[]
  prices             ProductPrice[]
  orderItems         OrderItem[]
  receiptItems       GoodsReceiptItem[]
  returnItems        ReturnItem[]
  heldCartItems      HeldCartItem[]
  transferItems      StockTransferItem[]
  adjustmentItems    StockAdjustmentItem[]

  @@index([companyId, productId, status])
  @@index([variantId])
}

model ProductBatch {
  id             String             @id @default(uuid()) @db.Uuid
  companyId      String             @db.Uuid
  productId      String             @db.Uuid
  variantId      String?            @db.Uuid
  warehouseId    String             @db.Uuid
  lotNumber      String
  variantKey     String             @default("BASE")
  manufacturedAt DateTime?
  expiresAt      DateTime?
  quantity       Decimal            @default(0) @db.Decimal(18, 3)
  reserved       Decimal            @default(0) @db.Decimal(18, 3)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product        Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  warehouse      Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  serials         ProductSerial[]
  receiptItems    GoodsReceiptItem[]
  transferItems   StockTransferItem[]
  adjustmentItems StockAdjustmentItem[]

  @@unique([companyId, productId, warehouseId, lotNumber, variantKey])
  @@index([companyId, warehouseId, expiresAt])
}

model ProductSerial {
  id          String              @id @default(uuid()) @db.Uuid
  companyId   String              @db.Uuid
  productId   String              @db.Uuid
  variantId   String?             @db.Uuid
  warehouseId String              @db.Uuid
  batchId     String?             @db.Uuid
  serial      String
  imei        String?
  status      ProductSerialStatus @default(AVAILABLE)
  soldOrderId String?             @db.Uuid
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  batch       ProductBatch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  soldOrder   Order?              @relation(fields: [soldOrderId], references: [id], onDelete: SetNull)

  @@unique([companyId, serial])
  @@unique([companyId, imei])
  @@index([companyId, productId, warehouseId, status])
}

model PriceList {
  id        String         @id @default(uuid()) @db.Uuid
  companyId String         @db.Uuid
  name      String
  code      String
  currency  String         @default("UZS")
  isDefault Boolean        @default(false)
  status    RecordStatus   @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  prices    ProductPrice[]
  primaryForProducts Product[] @relation("ProductPrimaryPriceList")
  orders    Order[]

  @@unique([companyId, code])
  @@index([companyId, status])
}

model ProductPrice {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   String          @db.Uuid
  priceListId String          @db.Uuid
  productId   String          @db.Uuid
  variantId   String?         @db.Uuid
  packageId   String?         @db.Uuid
  scopeKey    String          @default("BASE")
  price       Decimal         @db.Decimal(18, 2)
  validFrom   DateTime        @default(now())
  validTo     DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  priceList   PriceList       @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  package     ProductPackage? @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId, scopeKey, validFrom])
  @@index([companyId, productId, scopeKey, validTo])
  @@index([variantId])
  @@index([packageId])
}

model WarehouseStock {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   String          @db.Uuid
  warehouseId String          @db.Uuid
  productId   String          @db.Uuid
  variantId   String?         @db.Uuid
  stockKey    String          @default("BASE")
  onHand      Decimal         @default(0) @db.Decimal(18, 3)
  reserved    Decimal         @default(0) @db.Decimal(18, 3)
  version     Int             @default(0)
  updatedAt   DateTime        @updatedAt
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId, stockKey])
  @@index([companyId, productId])
  @@index([companyId, productId, variantId])
}

model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  companyId     String            @db.Uuid
  warehouseId   String            @db.Uuid
  productId     String            @db.Uuid
  variantId     String?           @db.Uuid
  packageId     String?           @db.Uuid
  batchId       String?           @db.Uuid
  employeeId    String?           @db.Uuid
  type          StockMovementType
  quantity      Decimal           @db.Decimal(18, 3)
  unitCost      Decimal?          @db.Decimal(18, 2)
  referenceType String?
  referenceId   String?
  reason        String?
  balanceAfter  Decimal           @db.Decimal(18, 3)
  createdAt     DateTime          @default(now())
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id])
  product       Product           @relation(fields: [productId], references: [id])
  employee      Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([companyId, warehouseId, productId, createdAt])
  @@index([companyId, referenceType, referenceId])
}

model StockReservation {
  id          String            @id @default(uuid()) @db.Uuid
  companyId   String            @db.Uuid
  orderId     String            @db.Uuid
  orderItemId String            @db.Uuid
  warehouseId String            @db.Uuid
  productId   String            @db.Uuid
  variantId   String?           @db.Uuid
  packageId   String?           @db.Uuid
  quantity    Decimal           @db.Decimal(18, 3)
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  product     Product           @relation(fields: [productId], references: [id])

  @@index([companyId, warehouseId, productId, status])
  @@index([orderId, status])
}

model StockTransfer {
  id                String              @id @default(uuid()) @db.Uuid
  companyId         String              @db.Uuid
  number            String
  sourceWarehouseId String              @db.Uuid
  targetWarehouseId String              @db.Uuid
  status            DocumentStatus      @default(DRAFT)
  note              String?
  approvedById      String?             @db.Uuid
  approvedAt        DateTime?
  dispatchedAt      DateTime?
  completedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  sourceWarehouse   Warehouse           @relation("TransferSource", fields: [sourceWarehouseId], references: [id])
  targetWarehouse   Warehouse           @relation("TransferTarget", fields: [targetWarehouseId], references: [id])
  items             StockTransferItem[]

  @@unique([companyId, number])
  @@index([companyId, status, createdAt])
}

model StockTransferItem {
  id         String          @id @default(uuid()) @db.Uuid
  transferId String          @db.Uuid
  productId  String          @db.Uuid
  variantId  String?         @db.Uuid
  packageId  String?         @db.Uuid
  batchId    String?         @db.Uuid
  quantity           Decimal         @db.Decimal(18, 3)
  displayQuantity    Decimal?        @db.Decimal(18, 3)
  conversionToBase   Decimal         @default(1) @db.Decimal(18, 6)
  received           Decimal         @default(0) @db.Decimal(18, 3)
  serialIds  Json            @default("[]")
  transfer   StockTransfer   @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id])
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  package    ProductPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
