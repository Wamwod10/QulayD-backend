generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CompanyStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CLOSED
}

enum EmployeeStatus {
  INVITED
  ACTIVE
  BLOCKED
  TERMINATED
}

enum OrderStatus {
  DRAFT
  PENDING_APPROVAL
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum FulfillmentStatus {
  UNFULFILLED
  RESERVED
  PICKING
  PICKED
  PACKING
  PACKED
  FULFILLED
  CANCELLED
}

enum DeliveryStatus {
  NOT_PLANNED
  PLANNED
  OUT_FOR_DELIVERY
  ARRIVED
  DELIVERED
  PARTIALLY_DELIVERED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  QR
  BANK
  CREDIT
  MIXED
  OTHER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum StockMovementType {
  OPENING
  GOODS_RECEIPT
  SALE
  RETURN_IN
  RETURN_OUT
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  COUNT_CORRECTION
  RESERVATION
  RESERVATION_RELEASE
}

enum DocumentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  CANCELLED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum CashTransactionType {
  OPENING
  SALE
  REFUND
  INCOME
  EXPENSE
  CASH_IN
  CASH_OUT
  CLOSING
}

enum LedgerSide {
  DEBIT
  CREDIT
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  ACTION_REQUIRED
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum UploadStatus {
  PENDING
  READY
  FAILED
  DELETED
}

enum VisitStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  MISSED
  CANCELLED
}

enum ReturnStatus {
  DRAFT
  REQUESTED
  INSPECTING
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
  CANCELLED
}

model Company {
  id                String                @id @default(uuid()) @db.Uuid
  name              String
  legalName         String?
  taxId             String?
  phone             String?
  email             String?
  address           String?
  plan              String                @default("TRIAL")
  status            CompanyStatus         @default(TRIAL)
  trialEndsAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?
  branches          Branch[]
  warehouses        Warehouse[]
  employees         Employee[]
  roles             Role[]
  categories        Category[]
  units             Unit[]
  products          Product[]
  priceLists        PriceList[]
  customers         Customer[]
  suppliers         Supplier[]
  orders            Order[]
  payments          Payment[]
  invoices          Invoice[]
  cashboxes         Cashbox[]
  settings          Settings?
  sessions          Session[]
  uploads           Upload[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  documentSequences DocumentSequence[]
  employeeTypes     EmployeeType[]
  paymentMethods    PaymentMethodConfig[]
  heldCarts         HeldCart[]
  approvals         Approval[]
  currencyRates     CurrencyRate[]

  @@index([status])
}

model Branch {
  id         String       @id @default(uuid()) @db.Uuid
  companyId  String       @db.Uuid
  name       String
  code       String
  address    String?
  phone      String?
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouses Warehouse[]
  employees  Employee[]
  orders     Order[]
  cashboxes  Cashbox[]

  @@unique([companyId, code])
  @@index([companyId, status])
}

model Warehouse {
  id               String             @id @default(uuid()) @db.Uuid
  companyId        String             @db.Uuid
  branchId         String?            @db.Uuid
  name             String
  code             String
  address          String?
  latitude         Decimal?           @db.Decimal(10, 7)
  longitude        Decimal?           @db.Decimal(10, 7)
  status           RecordStatus       @default(ACTIVE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch           Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employees        Employee[]
  stocks           WarehouseStock[]
  movements        StockMovement[]
  reservations     StockReservation[]
  sourceTransfers  StockTransfer[]    @relation("TransferSource")
  targetTransfers  StockTransfer[]    @relation("TransferTarget")
  inventoryCounts  InventoryCount[]
  stockAdjustments StockAdjustment[]
  orders           Order[]
  goodsReceipts    GoodsReceipt[]
  cashboxes        Cashbox[]
  deliveryTrips    DeliveryTrip[]

  @@unique([companyId, code])
  @@index([companyId, branchId, status])
}

model Employee {
  id                 String               @id @default(uuid()) @db.Uuid
  companyId          String               @db.Uuid
  branchId           String?              @db.Uuid
  warehouseId        String?              @db.Uuid
  employeeTypeId     String?              @db.Uuid
  login              String?              @unique
  phone              String?              @unique
  email              String?              @unique
  name               String
  title              String?
  passwordHash       String
  pinHash            String?
  mustChangePassword Boolean              @default(false)
  status             EmployeeStatus       @default(INVITED)
  lastLoginAt        DateTime?
  tokenVersion       Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch             Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  warehouse          Warehouse?           @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  employeeType       EmployeeType?        @relation(fields: [employeeTypeId], references: [id], onDelete: SetNull)
  roles              EmployeeRole[]
  modules            EmployeeModule[]
  sessions           Session[]
  passwordResets     PasswordResetToken[]
  createdOrders      Order[]              @relation("OrderCreator")
  assignedOrders     Order[]              @relation("OrderAgent")
  stockMovements     StockMovement[]
  notifications      Notification[]
  notificationReads  NotificationRead[]
  auditLogs          AuditLog[]
  shifts             Shift[]
  payments           Payment[]
  visits             Visit[]
  salaryKpis         EmployeeKpi[]
  salaryPayments     SalaryPayment[]
  deliveryTrips      DeliveryTrip[]       @relation("TripDriver")
  routeTemplates     RouteTemplate[]      @relation("TemplateAgent")
  routePlans         RoutePlan[]          @relation("PlanAgent")
  heldCarts          HeldCart[]
  approvalsRequested Approval[]           @relation("ApprovalRequester")
  approvalsReviewed  Approval[]           @relation("ApprovalReviewer")
  assignedPickLists  PickList[]

  @@index([companyId, status])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  companyId   String?          @db.Uuid
  code        String
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees   EmployeeRole[]
  permissions RolePermission[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  module      String
  action      String
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@index([module])
}

model EmployeeRole {
  employeeId String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([employeeId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model EmployeeModule {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @db.Uuid
  module     String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, module])
  @@index([employeeId, enabled])
}

model Category {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  parentId    String?      @db.Uuid
  name        String
  code        String?
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent      Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]   @relation("CategoryTree")
  products    Product[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId, status])
}

model Unit {
  id        String       @id @default(uuid()) @db.Uuid
  companyId String       @db.Uuid
  name      String
  shortName String
  precision Int          @default(0)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([companyId, name])
  @@unique([companyId, shortName])
}

model Product {
  id              String                @id @default(uuid()) @db.Uuid
  companyId       String                @db.Uuid
  categoryId      String?               @db.Uuid
  unitId          String                @db.Uuid
  sku             String
  name            String
  description     String?
  imageUrl        String?
  costPrice       Decimal               @default(0) @db.Decimal(18, 2)
  minStock        Decimal               @default(0) @db.Decimal(18, 3)
  trackStock      Boolean               @default(true)
  status          RecordStatus          @default(ACTIVE)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category        Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit            Unit                  @relation(fields: [unitId], references: [id])
  barcodes        ProductBarcode[]
  variants        ProductVariant[]
  prices          ProductPrice[]
  stocks          WarehouseStock[]
  movements       StockMovement[]
  reservations    StockReservation[]
  orderItems      OrderItem[]
  receiptItems    GoodsReceiptItem[]
  transferItems   StockTransferItem[]
  countItems      InventoryCountItem[]
  adjustmentItems StockAdjustmentItem[]
  returnItems     ReturnItem[]
  heldCartItems   HeldCartItem[]

  @@unique([companyId, sku])
  @@index([companyId, name])
  @@index([companyId, categoryId, status])
}

model ProductBarcode {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  productId String   @db.Uuid
  barcode   String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([companyId, barcode])
  @@index([productId])
}

model ProductVariant {
  id         String       @id @default(uuid()) @db.Uuid
  companyId  String       @db.Uuid
  productId  String       @db.Uuid
  name       String
  sku        String
  attributes Json         @default("{}")
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([companyId, sku])
  @@index([productId, status])
}

model PriceList {
  id        String         @id @default(uuid()) @db.Uuid
  companyId String         @db.Uuid
  name      String
  code      String
  currency  String         @default("UZS")
  isDefault Boolean        @default(false)
  status    RecordStatus   @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  prices    ProductPrice[]
  orders    Order[]

  @@unique([companyId, code])
  @@index([companyId, status])
}

model ProductPrice {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  priceListId String    @db.Uuid
  productId   String    @db.Uuid
  price       Decimal   @db.Decimal(18, 2)
  validFrom   DateTime  @default(now())
  validTo     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId, validFrom])
  @@index([companyId, productId, validTo])
}

model WarehouseStock {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  warehouseId String    @db.Uuid
  productId   String    @db.Uuid
  onHand      Decimal   @default(0) @db.Decimal(18, 3)
  reserved    Decimal   @default(0) @db.Decimal(18, 3)
  version     Int       @default(0)
  updatedAt   DateTime  @updatedAt
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([companyId, productId])
}

model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  companyId     String            @db.Uuid
  warehouseId   String            @db.Uuid
  productId     String            @db.Uuid
  employeeId    String?           @db.Uuid
  type          StockMovementType
  quantity      Decimal           @db.Decimal(18, 3)
  unitCost      Decimal?          @db.Decimal(18, 2)
  referenceType String?
  referenceId   String?
  reason        String?
  balanceAfter  Decimal           @db.Decimal(18, 3)
  createdAt     DateTime          @default(now())
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id])
  product       Product           @relation(fields: [productId], references: [id])
  employee      Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([companyId, warehouseId, productId, createdAt])
  @@index([companyId, referenceType, referenceId])
}

model StockReservation {
  id          String            @id @default(uuid()) @db.Uuid
  companyId   String            @db.Uuid
  orderId     String            @db.Uuid
  orderItemId String            @db.Uuid
  warehouseId String            @db.Uuid
  productId   String            @db.Uuid
  quantity    Decimal           @db.Decimal(18, 3)
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  product     Product           @relation(fields: [productId], references: [id])

  @@index([companyId, warehouseId, productId, status])
  @@index([orderId, status])
}

model StockTransfer {
  id                String              @id @default(uuid()) @db.Uuid
  companyId         String              @db.Uuid
  number            String
  sourceWarehouseId String              @db.Uuid
  targetWarehouseId String              @db.Uuid
  status            DocumentStatus      @default(DRAFT)
  note              String?
  approvedById      String?             @db.Uuid
  approvedAt        DateTime?
  completedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  sourceWarehouse   Warehouse           @relation("TransferSource", fields: [sourceWarehouseId], references: [id])
  targetWarehouse   Warehouse           @relation("TransferTarget", fields: [targetWarehouseId], references: [id])
  items             StockTransferItem[]

  @@unique([companyId, number])
  @@index([companyId, status, createdAt])
}

model StockTransferItem {
  id         String        @id @default(uuid()) @db.Uuid
  transferId String        @db.Uuid
  productId  String        @db.Uuid
  quantity   Decimal       @db.Decimal(18, 3)
  received   Decimal       @default(0) @db.Decimal(18, 3)
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product    Product       @relation(fields: [productId], references: [id])

  @@unique([transferId, productId])
}

model InventoryCount {
  id          String               @id @default(uuid()) @db.Uuid
  companyId   String               @db.Uuid
  warehouseId String               @db.Uuid
  number      String
  status      DocumentStatus       @default(DRAFT)
  countedAt   DateTime?
  note        String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  warehouse   Warehouse            @relation(fields: [warehouseId], references: [id])
  items       InventoryCountItem[]

  @@unique([companyId, number])
  @@index([companyId, warehouseId, status])
}

model InventoryCountItem {
  id         String         @id @default(uuid()) @db.Uuid
  countId    String         @db.Uuid
  productId  String         @db.Uuid
  expected   Decimal        @db.Decimal(18, 3)
  counted    Decimal        @db.Decimal(18, 3)
  difference Decimal        @db.Decimal(18, 3)
  count      InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  product    Product        @relation(fields: [productId], references: [id])

  @@unique([countId, productId])
}

model StockAdjustment {
  id          String                @id @default(uuid()) @db.Uuid
  companyId   String                @db.Uuid
  warehouseId String                @db.Uuid
  number      String
  status      DocumentStatus        @default(DRAFT)
  reason      String
  approvedAt  DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id])
  items       StockAdjustmentItem[]

  @@unique([companyId, number])
  @@index([companyId, warehouseId, status])
}

model StockAdjustmentItem {
  id           String          @id @default(uuid()) @db.Uuid
  adjustmentId String          @db.Uuid
  productId    String          @db.Uuid
  quantity     Decimal         @db.Decimal(18, 3)
  unitCost     Decimal?        @db.Decimal(18, 2)
  adjustment   StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id])

  @@unique([adjustmentId, productId])
}

model Customer {
  id                 String              @id @default(uuid()) @db.Uuid
  companyId          String              @db.Uuid
  code               String
  name               String
  phone              String?
  email              String?
  address            String?
  latitude           Decimal?            @db.Decimal(10, 7)
  longitude          Decimal?            @db.Decimal(10, 7)
  taxId              String?
  creditLimit        Decimal             @default(0) @db.Decimal(18, 2)
  balance            Decimal             @default(0) @db.Decimal(18, 2)
  status             RecordStatus        @default(ACTIVE)
  metadata           Json                @default("{}")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts           Contact[]
  orders             Order[]
  invoices           Invoice[]
  payments           Payment[]
  debts              Debt[]
  ledger             LedgerEntry[]
  deliveries         Delivery[]
  visits             Visit[]
  returns            Return[]
  routeTemplateStops RouteTemplateStop[]
  routePlanStops     RoutePlanStop[]
  heldCarts          HeldCart[]

  @@unique([companyId, code])
  @@index([companyId, name])
  @@index([companyId, phone])
}

model Supplier {
  id            String         @id @default(uuid()) @db.Uuid
  companyId     String         @db.Uuid
  code          String
  name          String
  phone         String?
  email         String?
  address       String?
  taxId         String?
  balance       Decimal        @default(0) @db.Decimal(18, 2)
  status        RecordStatus   @default(ACTIVE)
  metadata      Json           @default("{}")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts      Contact[]
  goodsReceipts GoodsReceipt[]
  debts         Debt[]
  ledger        LedgerEntry[]
  payments      Payment[]

  @@unique([companyId, code])
  @@index([companyId, name])
}

model Contact {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @db.Uuid
  customerId String?   @db.Uuid
  supplierId String?   @db.Uuid
  name       String
  position   String?
  phone      String?
  email      String?
  isPrimary  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([companyId, customerId])
  @@index([companyId, supplierId])
}

model Order {
  id                String               @id @default(uuid()) @db.Uuid
  companyId         String               @db.Uuid
  branchId          String?              @db.Uuid
  warehouseId       String               @db.Uuid
  customerId        String?              @db.Uuid
  priceListId       String?              @db.Uuid
  createdById       String               @db.Uuid
  agentId           String?              @db.Uuid
  number            String
  channel           String               @default("SALES")
  status            OrderStatus          @default(DRAFT)
  fulfillmentStatus FulfillmentStatus    @default(UNFULFILLED)
  deliveryStatus    DeliveryStatus       @default(NOT_PLANNED)
  paymentStatus     InvoiceStatus        @default(DRAFT)
  currency          String               @default("UZS")
  subtotal          Decimal              @default(0) @db.Decimal(18, 2)
  discount          Decimal              @default(0) @db.Decimal(18, 2)
  tax               Decimal              @default(0) @db.Decimal(18, 2)
  total             Decimal              @default(0) @db.Decimal(18, 2)
  note              String?
  deliveryAddress   String?
  orderedAt         DateTime             @default(now())
  confirmedAt       DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch            Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  warehouse         Warehouse            @relation(fields: [warehouseId], references: [id])
  customer          Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  priceList         PriceList?           @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  createdBy         Employee             @relation("OrderCreator", fields: [createdById], references: [id])
  agent             Employee?            @relation("OrderAgent", fields: [agentId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  reservations      StockReservation[]
  history           OrderStatusHistory[]
  pickLists         PickList[]
  packing           Packing?
  deliveries        Delivery[]
  invoices          Invoice[]
  payments          Payment[]
  receipt           Receipt?
  returns           Return[]

  @@unique([companyId, number])
  @@index([companyId, status, orderedAt])
  @@index([companyId, customerId, orderedAt])
}

model OrderItem {
  id           String             @id @default(uuid()) @db.Uuid
  orderId      String             @db.Uuid
  productId    String             @db.Uuid
  quantity     Decimal            @db.Decimal(18, 3)
  fulfilledQty Decimal            @default(0) @db.Decimal(18, 3)
  unitPrice    Decimal            @db.Decimal(18, 2)
  discount     Decimal            @default(0) @db.Decimal(18, 2)
