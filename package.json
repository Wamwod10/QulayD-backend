{
  "name": "qulay-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Production backend API for the Qulay distribution business control system.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "build": "npm run prisma:generate && node scripts/validate-build.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "pglite-server --db=memory:// --port=55432 --host=127.0.0.1 -m 20 --include-database-url --run \"node scripts/e2e-smoke.mjs\"",
    "test:watch": "vitest",
    "check": "npm run lint && npm run build && npm run test",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.12.1",
    "multer": "2.3.0",
    "pg": "8.16.3",
    "pino": "10.3.1",
    "sharp": "0.35.4",
    "swagger-ui-express": "5.0.1",
    "yaml": "2.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@electric-sql/pglite-socket": "0.1.3",
    "@eslint/js": "10.0.1",
    "eslint": "10.0.1",
    "globals": "17.3.0",
    "nodemon": "3.1.14",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "vitest": "4.1.11"
  }
}
